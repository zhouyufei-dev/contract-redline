# Copy this file to `.env` and fill in your own key.
#
#   Copy-Item .env.example .env
#
# Then put your real key on the DEEPSEEK_API_KEY line. Never commit `.env`
# (it is already in .gitignore) and never paste the key into a chat or a ticket.

# --- required ---------------------------------------------------------------
# Get one at https://platform.deepseek.com  ->  API keys.
DEEPSEEK_API_KEY=

# --- optional: sensible defaults are already built in ------------------------
# Model name. `deepseek-chat` is the one this project was tested against.
DEEPSEEK_MODEL=deepseek-chat

# API base URL. The client appends `/chat/completions` itself.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Seconds before a single request is abandoned.
DEEPSEEK_TIMEOUT=60

# Retries for network errors and 429/5xx. 401/403 is never retried.
DEEPSEEK_MAX_RETRIES=3

# 0.0-2.0. Low on purpose: we want the same contract to read the same way twice.
DEEPSEEK_TEMPERATURE=0.2

# How many findings are explained at the same time. 1 = strictly one by one.
DEEPSEEK_MAX_WORKERS=4

# --- payments: needed for the paywall ---------------------------------------
# Server-side key, used only to ask Stripe "was this Checkout Session paid?".
# Starts with sk_test_ while testing and sk_live_ once real money moves. Never
# commit it and never paste it anywhere else. Empty is allowed: the page then
# reports that payments are not configured instead of unlocking anything.
STRIPE_SECRET_KEY=

# The Stripe Payment Link the "Unlock" button opens. This is public by design
# (it goes on the page), kept here only so test mode and live mode are one line
# apart. Leave it empty to use the live link built into app/site.py.
# Test-mode links always contain "/test_"; a live link never does.
STRIPE_PAYMENT_URL=
