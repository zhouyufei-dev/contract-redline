# The shape of Streamlit Cloud's "Secrets" box, for copy-paste.
#
# Streamlit Cloud does NOT read .env and does not put secrets in the process
# environment: it hands them to the app as st.secrets, which app/config.py reads
# as its third source. Paste the four lines below into
#   App -> Settings -> Secrets
# with your real values, and nothing else changes.
#
# This file is documentation only. It is never read at runtime: the real file is
# .streamlit/secrets.toml, which is git-ignored so it can never be pushed.

DEEPSEEK_API_KEY = "sk-..."
STRIPE_SECRET_KEY = "sk_test_..."
STRIPE_PAYMENT_URL = "https://buy.stripe.com/test_..."
